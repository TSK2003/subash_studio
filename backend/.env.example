# Subash Studio - Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / AWS RDS PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/subash_studio?schema=public"

# Authentication Security (Required: minimum 32 random characters in production)
JWT_SECRET=replace_with_a_secure_random_32_char_secret_in_production

# Initial Admin User (Provisioned on initial startup if database is empty)
INITIAL_ADMIN_EMAIL=subashstudio009@gmail.com
INITIAL_ADMIN_PASSWORD=

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Google Business Profile Reviews Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# AWS Storage & CloudFront CDN
# (If AWS_S3_BUCKET is empty, automatically falls back to local disk storage in development)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# On EC2 with an IAM role, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=
