# Subash Studio - Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/subash_studio?schema=public"

# Authentication Security (Min 32 random characters in production)
JWT_SECRET=subash_studio_jwt_super_secret_key_change_in_production_2026

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Google Business Profile Reviews Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# AWS S3 Storage (Optional - falls back to local disk storage if empty)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
