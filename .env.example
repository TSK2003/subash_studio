# Google Business Profile Reviews API Integration
# Note: Google credentials must be server-only and NEVER prefixed with VITE_

# Google Cloud OAuth 2.0 Web Application Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth Redirect URI (configured in Google Cloud Console -> Credentials -> Authorized redirect URIs)
# In development: http://localhost:5173/api/auth/google/callback
# In production: https://yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: Specific Google Business Account ID and Location ID
# If left empty, the server automatically queries the user's first authorized Account & Location
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Optional: Server-side stored refresh token (in production serverless environments like Vercel or Cloud Functions)
GOOGLE_REFRESH_TOKEN=

# PostgreSQL Database Connection (Prisma)
# Example: postgresql://postgres:password@localhost:5432/subash_studio?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
