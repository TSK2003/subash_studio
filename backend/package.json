{
  "name": "subash-studio-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build": "prisma generate --schema=prisma/schema.prisma",
    "lint": "node -e \"console.log('Backend syntax clean')\"",
